//@version=5
// XAUUSD Scalper: Liquidity Sweep -> CHoCH -> Entry (SMC + MSNR) — TP 1000 pts / SL 300-500 pts
// ตรรกะ (ใช้บน M1/M5):
//   1) ราคาเข้าโซน SMC/MSNR จาก TF ใหญ่
//   2) ราคากวาด swing low/high ล่าสุด (wick ทะลุแล้วปิดกลับ) = ล้าง stop / liquidity sweep
//   3) ภายใน N แท่ง ราคาปิดทะลุ swing ฝั่งตรงข้าม (CHoCH) = ยืนยันการกลับตัว
//   4) SL อยู่เลยจุดสุดของ wick ที่กวาด + buffer (บังคับให้อยู่ในช่วง 300-500 pts), TP คงที่ 1000 pts
//      - ถ้า SL ไกลเกิน 500 pts -> ตั้ง Limit ที่ SL + 500 pts (รอราคาย้อน)
//      - ถ้า SL ใกล้กว่า 300 pts -> ขยาย SL เป็น 300 pts
// ระดับโซนเริ่มต้นประมาณจากกราฟรายวัน (±$30) ปรับให้ตรงกราฟโบรกเกอร์ของคุณ
// ยังไม่ผ่านการ backtest ไม่ใช่คำแนะนำการลงทุน
indicator("XAUUSD Scalper: Sweep + CHoCH", overlay = true, max_lines_count = 500, max_labels_count = 125)

// ---------- เป้า / ความเสี่ยง ----------
gR    = "เป้า / ความเสี่ยง"
pt    = input.float(0.01, "ขนาด 1 point (ทอง 2 ทศนิยม = 0.01)", group = gR)
tpPts = input.int(1000, "TP (points)", group = gR)
slMin = input.int(300,  "SL ต่ำสุด (points)", group = gR)
slMax = input.int(500,  "SL สูงสุด (points)", group = gR)
buf   = input.int(40,   "Buffer เลยจุดที่ถูกกวาด (points)", group = gR)
bePts = input.int(500,  "ระยะที่เลื่อน SL มาทุน (points)", group = gR)

// ---------- สัญญาณ ----------
gS       = "สัญญาณ"
mode     = input.string("Follow HTF trend", "ฝั่งที่เทรด", options = ["Follow HTF trend", "Both sides", "Sell only", "Buy only"], group = gS)
biasTF   = input.timeframe("60", "TF ใหญ่ดูเทรนด์", group = gS)
biasLen  = input.int(50, "EMA ของ TF ใหญ่", minval = 2, group = gS)
pivLen   = input.int(2, "ความยาว swing (แท่ง)", minval = 1, group = gS)
sweepWin = input.int(12, "CHoCH ต้องเกิดภายใน N แท่งหลังกวาด", minval = 1, group = gS)
zoneWin  = input.int(30, "ต้องแตะโซนภายใน N แท่งล่าสุด", minval = 1, group = gS)
useZone  = input.bool(true, "กรองด้วยโซน (ปิด = ทุกจุดที่เกิด sweep + CHoCH)", group = gS)

// ---------- โซนจาก TF ใหญ่ ----------
gZ    = "โซน (ปรับให้ตรงกราฟโบรกเกอร์)"
sTop  = input.float(4305, "Sell zone บน (Bearish OB)",   group = gZ)
sBot  = input.float(4166, "Sell zone ล่าง (Bearish FVG)", group = gZ)
b1Top = input.float(4140, "Buy zone 1 บน (MSNR flip)",   group = gZ)
b1Bot = input.float(4119, "Buy zone 1 ล่าง",             group = gZ)
b2Top = input.float(4081, "Buy zone 2 บน (Bullish OB+FVG)", group = gZ)
b2Bot = input.float(4027, "Buy zone 2 ล่าง",                group = gZ)

cRed   = #e34948
cBlue  = #2a78d6
cGreen = #1baf7a
cGray  = #9a998f

hS1 = hline(sTop,  "Sell zone บน",   color = color.new(cRed, 60),   linestyle = hline.style_dotted)
hS2 = hline(sBot,  "Sell zone ล่าง",  color = color.new(cRed, 60),   linestyle = hline.style_dotted)
hB1 = hline(b1Top, "Buy1 บน",        color = color.new(cBlue, 60),  linestyle = hline.style_dotted)
hB2 = hline(b1Bot, "Buy1 ล่าง",       color = color.new(cBlue, 60),  linestyle = hline.style_dotted)
hB3 = hline(b2Top, "Buy2 บน",        color = color.new(cGreen, 60), linestyle = hline.style_dotted)
hB4 = hline(b2Bot, "Buy2 ล่าง",       color = color.new(cGreen, 60), linestyle = hline.style_dotted)
fill(hS1, hS2, color = color.new(cRed, 90))
fill(hB1, hB2, color = color.new(cBlue, 88))
fill(hB3, hB4, color = color.new(cGreen, 90))

// ---------- เทรนด์ TF ใหญ่ (ไม่ repaint) ----------
htfEma   = request.security(syminfo.tickerid, biasTF, ta.ema(close, biasLen)[1], lookahead = barmerge.lookahead_on)
htfClose = request.security(syminfo.tickerid, biasTF, close[1], lookahead = barmerge.lookahead_on)
biasTFx  = biasTF == "" ? timeframe.period : biasTF
tfOk     = timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds(biasTFx)
bias     = tfOk ? (htfClose > htfEma ? 1 : htfClose < htfEma ? -1 : 0) : 0

allowSell = mode == "Both sides" or mode == "Sell only" or (mode == "Follow HTF trend" and bias < 0)
allowBuy  = mode == "Both sides" or mode == "Buy only"  or (mode == "Follow HTF trend" and bias > 0)

// ---------- โซนถูกแตะเมื่อไม่นานมานี้ ----------
touchedSell = nz(ta.barssince(high >= sBot and low <= sTop), 99999) < zoneWin
touchedBuy  = nz(ta.barssince((low <= b1Top and high >= b1Bot) or (low <= b2Top and high >= b2Bot)), 99999) < zoneWin

// ---------- โครงสร้าง TF เล็ก: swing, sweep, CHoCH ----------
var float lastPH = na
var float lastPL = na
var float swLow  = na
var int   swLowBar  = na
var float swLowLvl  = na
var bool  swLowZone = false
var bool  swLowOk   = false
var float swHigh = na
var int   swHighBar = na
var float swHighLvl = na
var bool  swHighZone = false
var bool  swHighOk   = false
var int   nSwL  = 0
var int   nSwH  = 0
var int   nBuy  = 0
var int   nSell = 0

// sweep = wick ทะลุ swing ล่าสุดแต่ปิดกลับมาอีกฝั่ง (ตรวจก่อนอัปเดต swing ของแท่งนี้)
sweptLow  = not na(lastPL) and low < lastPL and close > lastPL
sweptHigh = not na(lastPH) and high > lastPH and close < lastPH

lowOpen  = not na(swLowBar)  and bar_index - swLowBar  <= sweepWin
highOpen = not na(swHighBar) and bar_index - swHighBar <= sweepWin

// เก็บจุดสุดของ wick ไว้เสมอ (ไว้วาง SL) แต่ถ้าราคาปิดกลับไปเลยระดับที่ถูกกวาด
// = breakdown จริง ไม่ใช่ sweep -> setup ใช้ไม่ได้ จนกว่าจะมี sweep ใหม่
if sweptLow
    swLow := lowOpen ? math.min(swLow, low) : low
    swLowLvl := lastPL
    swLowZone := touchedBuy
    swLowOk := true
    swLowBar := bar_index
    nSwL += 1
else if lowOpen
    swLow := math.min(swLow, low)
    if close <= swLowLvl
        swLowOk := false

if sweptHigh
    swHigh := highOpen ? math.max(swHigh, high) : high
    swHighLvl := lastPH
    swHighZone := touchedSell
    swHighOk := true
    swHighBar := bar_index
    nSwH += 1
else if highOpen
    swHigh := math.max(swHigh, high)
    if close >= swHighLvl
        swHighOk := false

ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)
if not na(ph)
    lastPH := ph
if not na(pl)
    lastPL := pl

lowLive  = not na(swLowBar)  and bar_index - swLowBar  <= sweepWin and swLowOk
highLive = not na(swHighBar) and bar_index - swHighBar <= sweepWin and swHighOk

bullChoch = not na(lastPH) and close > lastPH and close[1] <= lastPH
bearChoch = not na(lastPL) and close < lastPL and close[1] >= lastPL

buySig  = barstate.isconfirmed and lowLive  and bullChoch and allowBuy  and (not useZone or swLowZone)
sellSig = barstate.isconfirmed and highLive and bearChoch and allowSell and (not useZone or swHighZone)

// ---------- วาด Entry / SL / TP ----------
f_px(x) =>
    str.tostring(x, format.mintick)

f_draw(entry, sl, tp, be, kind, isSell) =>
    col = isSell ? cRed : cBlue
    x2  = bar_index + 25
    line.new(bar_index, entry, x2, entry, color = col, width = 2)
    line.new(bar_index, sl,    x2, sl,    color = cRed, style = line.style_dashed)
    line.new(bar_index, tp,    x2, tp,    color = cGreen, width = 2)
    line.new(bar_index, be,    x2, be,    color = cGray, style = line.style_dotted)
    riskPts = math.abs(sl - entry) / pt
    rr = tpPts / riskPts
    txt = kind + "\nEntry " + f_px(entry) + "\nSL " + f_px(sl) + " (" + str.tostring(riskPts, "#") + " pts)" +
         "\nTP " + f_px(tp) + " (" + str.tostring(tpPts) + " pts, RR " + str.tostring(rr, "#.#") + ")" +
         "\nเลื่อน SL มาทุนที่ " + f_px(be)
    label.new(bar_index, sl, txt, style = isSell ? label.style_label_down : label.style_label_up,
         color = col, textcolor = color.white, size = size.small)
    txt

if buySig
    sl    = swLow - buf * pt
    entry = close
    kind  = "BUY (market)"
    if entry - sl > slMax * pt
        entry := sl + slMax * pt
        kind  := "BUY LIMIT"
    else if entry - sl < slMin * pt
        sl := entry - slMin * pt
    msg = f_draw(entry, sl, entry + tpPts * pt, entry + bePts * pt, kind, false)
    alert("XAUUSD " + msg, alert.freq_once_per_bar_close)
    swLowBar := na
    nBuy += 1

if sellSig
    sl    = swHigh + buf * pt
    entry = close
    kind  = "SELL (market)"
    if sl - entry > slMax * pt
        entry := sl - slMax * pt
        kind  := "SELL LIMIT"
    else if sl - entry < slMin * pt
        sl := entry + slMin * pt
    msg = f_draw(entry, sl, entry - tpPts * pt, entry - bePts * pt, kind, true)
    alert("XAUUSD " + msg, alert.freq_once_per_bar_close)
    swHighBar := na
    nSell += 1

// ---------- ตารางสถานะ ----------
atrPts  = ta.atr(14) / pt
biasTxt = not tfOk ? "Bias TF ใหญ่: ใช้ไม่ได้ (TF กราฟใหญ่กว่า TF ที่เลือก)" : bias > 0 ? "Bias TF ใหญ่: ขึ้น (Buy)" : bias < 0 ? "Bias TF ใหญ่: ลง (Sell)" : "Bias TF ใหญ่: เป็นกลาง"
var table t = table.new(position.top_center, 1, 4, bgcolor = color.new(color.gray, 80))
if barstate.islast
    atrOk = atrPts <= slMax * 1.5
    table.cell(t, 0, 0, "ATR(14) TF นี้ = " + str.tostring(atrPts, "#") + " pts" + (atrOk ? "" : "  ⚠ ใช้ TF เล็กลง"), text_color = atrOk ? color.gray : cRed, text_size = size.small)
    table.cell(t, 0, 1, biasTxt, text_color = bias > 0 ? cGreen : bias < 0 ? cRed : color.gray, text_size = size.small)
    table.cell(t, 0, 2, "พบ sweep: ต่ำ " + str.tostring(nSwL) + " / สูง " + str.tostring(nSwH) + "  |  สัญญาณ: Buy " + str.tostring(nBuy) + " / Sell " + str.tostring(nSell) + " (ทั้งกราฟ)", text_color = color.gray, text_size = size.small)
    stTxt = lowLive ? "สถานะ: sweep ต่ำเมื่อ " + str.tostring(bar_index - swLowBar) + " แท่งก่อน รอ CHoCH ขึ้น" : highLive ? "สถานะ: sweep สูงเมื่อ " + str.tostring(bar_index - swHighBar) + " แท่งก่อน รอ CHoCH ลง" : "สถานะ: รอ sweep"
    table.cell(t, 0, 3, stTxt, text_color = (lowLive or highLive) ? cBlue : color.gray, text_size = size.small)

plotshape(sweptLow  and barstate.isconfirmed, "Sweep low",  shape.diamond, location.belowbar, color.new(cBlue, 30), size = size.tiny)
plotshape(sweptHigh and barstate.isconfirmed, "Sweep high", shape.diamond, location.abovebar, color.new(cRed, 30),  size = size.tiny)
plotshape(buySig,  "Buy signal",  shape.triangleup,   location.belowbar, cBlue, size = size.small)
plotshape(sellSig, "Sell signal", shape.triangledown, location.abovebar, cRed,  size = size.small)
// ตั้ง Alert แบบใดแบบหนึ่ง: "Any alert() function call" (ข้อความมี Entry/SL/TP) หรือ "Scalper BUY/SELL" (ข้อความสั้น) อย่าตั้งซ้อนกัน
alertcondition(buySig,  "Scalper BUY",  "XAUUSD: Sweep low + Bullish CHoCH")
alertcondition(sellSig, "Scalper SELL", "XAUUSD: Sweep high + Bearish CHoCH")
